# =============================================================================
# EscuchaInterna — variables de entorno
# Copia este archivo a `.env.local` (gitignored) y rellena los valores.
# En PRODUCCIÓN, define APP_ENV=production (o NODE_ENV=production): entonces los
# secretos marcados [OBLIGATORIO EN PROD] dejan de tener respaldo de desarrollo y
# la app NO arranca operaciones de sesión/cifrado sin ellos (fail-hard).
# =============================================================================

# --- Entorno ---------------------------------------------------------------
# 'production' activa el modo estricto (fail-hard de secretos, sin fugas de dev).
APP_ENV=development
# URL pública base (enlaces de correo, reservas, recuperación de contraseña).
APP_URL=http://localhost:3000

# --- Secretos [OBLIGATORIOS EN PROD] (mínimo 16 caracteres) ----------------
# Firma de las cookies de sesión (HMAC). Genera uno aleatorio y largo.
SESSION_SECRET=
# Clave del cifrado at-rest de los campos clínicos (AES-256-GCM). Si falta en
# producción, la app NO cifra con una clave de relleno: lanza. Guárdala en un
# gestor de secretos y NUNCA la cambies sin un plan de re-cifrado.
DATA_ENCRYPTION_KEY=

# --- Provisión del PRIMER admin en producción ------------------------------
# En producción el seed JAMÁS crea cuentas demo (sería un backdoor). El primer
# admin se provisiona de forma explícita con estas dos variables: solo se usan
# si aún NO existe ningún admin (idempotente) y la contraseña debe cumplir la
# política de claves. Ver src/shared/infrastructure/persistence/seed.ts
# (bootstrapProductionAdmin). Tras el primer arranque puedes retirarlas.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Canal: CORREO transaccional (Resend) ----------------------------------
# Define RESEND_API_KEY para activar el envío REAL (recordatorios, recuperación
# de contraseña, facturas, consentimientos). Sin ella, el correo queda solo en
# el outbox in-app (modo simulado).
RESEND_API_KEY=
EMAIL_FROM=EscuchaInterna <no-reply@escuchainterna.com>

# --- Canal: WhatsApp (WhatsApp Business Cloud API) -------------------------
# Ambas activan el envío real por WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Canal: PAGOS (pasarela de la suscripción) -----------------------------
# Mercado Pago = pasarela base para LatAm (una integración cubre AR/BR/CL/CO/MX/PE/UY…).
# (RESERVADAS: la pasarela de pago real aún no está implementada; el checkout
# actual es simulado. Hoy NINGÚN código lee las MERCADOPAGO_*.)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Stripe (complementario, donde convenga).
# (RESERVADAS: la pasarela de pago real aún no está implementada; el checkout
# actual es simulado. STRIPE_SECRET_KEY solo la lee el panel de estado de
# canales para mostrar "configurado"; STRIPE_WEBHOOK_SECRET no la lee ningún
# código todavía.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Canal: IA (Anthropic) -------------------------------------------------
# Sin clave, el asistente usa el motor local. Con clave, usa la API real.
ANTHROPIC_API_KEY=

# --- Jobs programados (re-plataforma 0f) -----------------------------------
# Un scheduler EXTERNO (Cloudflare Cron, GitHub Action, worker) hace POST a
# /api/jobs/run con cabecera "Authorization: Bearer $JOBS_SECRET" para drenar el
# outbox (reintentos de correo) y correr automatizaciones vencidas. Sin esta
# variable el endpoint está deshabilitado (503).
# JOBS_SECRET=

# --- Base de datos de RED (Postgres/Supabase) — re-plataforma a escala -----
# Si DATABASE_URL está presente, la app usa PostgreSQL (producción/escala). Si NO, usa el
# SQLite local de DATABASE_PATH (desarrollo). Ver docs/replatform-postgres-spec.md.
# DATABASE_URL=postgres://usuario:clave@host:5432/escuchainterna
# Storage de objetos (Supabase Storage, API REST) para los adjuntos del paciente.
# Si las TRES están presentes, los archivos van al bucket; si no, a disco local (dev).
# El contenido se CIFRA at-rest antes de subir (igual que en disco). Ver getPatientFileStorage.
# SUPABASE_STORAGE_URL=https://<proyecto>.supabase.co
# SUPABASE_STORAGE_BUCKET=archivos
# SUPABASE_SERVICE_ROLE_KEY=<service_role_key>   # NUNCA exponer al cliente

# --- Rutas de datos LOCALES (dev; SQLite + disco) --------------------------
# DATABASE_PATH=./data/escuchainterna.db
# CIE11_DATASET_PATH=./data/cie11/cie11.json
# UPLOADS_PATH=./data/uploads
# BIBLIOTECA_PATH=./data/biblioteca
# PUBLICACIONES_MANIFEST_PATH=./data/publicaciones/manifest.json
